{
  "$schema": "https://app.kilo.ai/config.json",
  "provider": {
    "amazon-bedrock": {
      "options": {
        "profile": "dev",
        "region": "us-east-1"
      }
    }
  },
  "permission": {
    "bash": "allow"
  },
  "lsp": {
    "ruby": {
      "command": [
        "ruby-lsp"
      ],
      "extensions": [
        ".rb",
        ".erb"
      ]
    },
    "python": {
      "command": [
        "ruff",
        "server"
      ],
      "extensions": [
        ".py"
      ]
    }
  }
}
