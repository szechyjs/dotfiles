{
  "$schema": "https://app.kilo.ai/config.json",
  "lsp": true,
  "plugin": [
    "opencode-wakatime",
    "@slkiser/opencode-quota"
  ],
  "mcp": {
    "notion": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.notion.com/mcp"
    },
    "dash": {
      "enabled": false,
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/Kapeli/dash-mcp-server.git",
        "dash-mcp-server"
      ]
    }
  }
  // "provider": {
  //   "amazon-bedrock": {
  //     "options": {
  //       "profile": "dev",
  //       "region": "us-east-1"
  //     }
  //   }
  // }
}
